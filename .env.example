# 复制为 .env 后使用：docker compose --env-file .env up -d --build

# 数据库
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=change-this-db-password

# 后端安全配置（JWT_SECRET 必须是 Base64 编码、解码后至少 32 字节）
JWT_SECRET=cmVwbGFjZS10aGlzLXdpdGgtYS1sb25nLXJhbmRvbS1zZWNyZXQta2V5
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Admin123
ADMIN_NICKNAME=站长

# 站点信息
BLOG_TITLE=墨迹 · Inkwell
BLOG_DESCRIPTION=一个关于代码、设计与长期主义的个人空间。
BLOG_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# 是否写入演示文章（首次部署建议 false）
BLOG_DEMO_DATA=false
