<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blog.article.ArticleTagMapper">

    <select id="selectByArticleIds" resultType="com.blog.article.ArticleTag">
        SELECT id, article_id, tag_name, created_at
        FROM article_tags
        WHERE article_id IN
        <foreach collection="articleIds" item="articleId" open="(" separator="," close=")">
            #{articleId}
        </foreach>
        ORDER BY id ASC
    </select>

    <delete id="deleteByArticleId">
        DELETE FROM article_tags WHERE article_id = #{articleId}
    </delete>

    <insert id="insert" parameterType="com.blog.article.ArticleTag"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO article_tags (article_id, tag_name, created_at)
        VALUES (#{articleId}, #{tagName}, #{createdAt})
    </insert>

</mapper>
